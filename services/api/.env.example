# Match API environment example. Copy to .env and adjust.
MATCH_ENVIRONMENT=development
MATCH_API_PREFIX=/api/v1
MATCH_DATABASE_URL=postgresql+asyncpg://match:match@localhost:5433/match

# LLM Gateway (Stage 6). Order: primary + comma-separated fallbacks.
# Providers: echo (offline default), ollama (local), openai (OpenAI-compatible cloud API).
MATCH_LLM_PROVIDER=echo
MATCH_LLM_FALLBACK_PROVIDERS=echo
MATCH_LLM_USER_REQUEST_LIMIT=0

# Ollama
MATCH_OLLAMA_BASE_URL=http://localhost:11434
MATCH_OLLAMA_MODEL=qwen3.5:9b

# OpenAI-compatible cloud provider (fill to enable; empty key disables it)
MATCH_OPENAI_BASE_URL=https://api.openai.com/v1
MATCH_OPENAI_API_KEY=
MATCH_OPENAI_MODEL=gpt-4o-mini

# Generation parameters
MATCH_LLM_TIMEOUT_SECONDS=30
MATCH_LLM_MAX_TOKENS=512
MATCH_LLM_TEMPERATURE=0.7

# Load protection (Stage 9). Requests per user per minute; 0 = disabled.
# Backend (Stage 14): "memory" = in-process sliding window (single instance),
# "db" = counters in `rate_limit_counters`, works with several instances.
MATCH_RATE_LIMIT_PER_MINUTE=0
MATCH_RATE_LIMIT_BACKEND=memory

# Vision analysis (Stage 11). Order: primary + comma-separated fallbacks.
# Providers: ollama (local default, frame stays on the machine), openai (cloud, needs key).
MATCH_VISION_PROVIDER=ollama
MATCH_VISION_FALLBACK_PROVIDERS=
MATCH_VISION_MODEL=qwen3.5:9b
MATCH_VISION_OLLAMA_BASE_URL=http://localhost:11434
MATCH_VISION_MAX_TOKENS=512
MATCH_VISION_TEMPERATURE=0.2

# Access tokens (Stage 12). Legacy `token_ref` auth (auto-provisioning) stays enabled
# for development; set to false to require issued tokens only.
MATCH_AUTH_ALLOW_LEGACY_TOKENS=true

# Admin cabinet (Stage 15). Comma-separated `token_ref` values promoted to role `admin`.
# Empty = no admins (admin endpoints return 403).
MATCH_ADMIN_TOKEN_REFS=
